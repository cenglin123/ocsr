{
  "name": "@ocsr/dsh-ocsr",
  "version": "0.2.0",
  "description": "An ocsr skill and an ocsr_dispatch tool that run headless opencode run as fresh-context, cross-vendor worker backends.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "subagents",
    "dispatch"
  ],
  "homepage": "https://github.com/cenglin123/ocsr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cenglin123/ocsr.git"
  },
  "bugs": {
    "url": "https://github.com/cenglin123/ocsr/issues"
  },
  "author": "cenglin123",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./tool": "./lib/tool-ocsr.js"
  },
  "files": [
    "lib/*.js",
    "SKILL.md",
    "scripts/*.py",
    "scripts/*.ps1",
    "scripts/*.cs",
    "refs/*.md",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test:adapter": "node --test tests/adapter/*.test.mjs"
  },
  "engines": {
    "dsh": "^0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-skill": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  }
}
